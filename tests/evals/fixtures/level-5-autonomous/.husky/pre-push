#!/bin/sh
# Smart test caching — skip if HEAD hasn't changed since last passing run
LAST_PASS_SHA=$(cat .test-passed 2>/dev/null || echo "none")
CURRENT_SHA=$(git rev-parse HEAD)

if [ "$LAST_PASS_SHA" = "$CURRENT_SHA" ]; then
  echo "Tests already passed for $CURRENT_SHA — skipping"
  exit 0
fi

npm test
if [ $? -eq 0 ]; then
  echo "$CURRENT_SHA" > .test-passed
fi

# File size check
node .claude/scripts/check-file-sizes.js
