{
  "name": "enforced-project",
  "version": "1.0.0",
  "description": "A project with linting, testing, hooks, and CLAUDE.md — should score Level 3 (Enforced)",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "dev": "tsx watch src/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"]
  }
}
